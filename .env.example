# =============================================================================
# Tactiq — орчны хувьсагчид
#
# Энэ файлыг `.env.local` болгон хуулаад утгуудыг бөглөнө үү:
#   cp .env.example .env.local
#
# ⚠ `NEXT_PUBLIC_` угтвартай хувьсагчид BUILD ҮЕД кодод шигтгэгддэг.
#   Тэдгээрийг сервер дээр өөрчилсний дараа ЗААВАЛ дахин build хийнэ —
#   зөвхөн restart хийхэд шинэ утга кодод орохгүй.
#
# Тохиргоо зөв эсэхийг `/api/health` хуудсаас шалгана.
# =============================================================================


# -----------------------------------------------------------------------------
# Өгөгдлийн сан (PostgreSQL 14+)
# -----------------------------------------------------------------------------
# Хэрэглэгчийн бүртгэл, төхөөрөмж, системийн тохиргоо энд байрлана.
#
# ⚠ Хоосон, ЗӨВХӨН Tactiq-д зориулсан сан ашиглана уу. `npm run db:push` нь
#   схемд байхгүй хүснэгтийг УСТГАХ санал болгодог тул өөр аппын сан руу
#   чиглүүлбэл тэр аппын өгөгдөл алдагдана.
DATABASE_URL=postgresql://user:password@localhost:5432/tactiq

# Хостинг нь TLS шаарддаг бол (Hostinger, Neon, Supabase гэх мэт) `true`
DATABASE_SSL=false

# Холболтын сангийн хэмжээ. Хуваалцсан хостинг дээр 5-10 хангалттай —
# хэт өндөр тавибал сервер "too many connections" гэж татгалзана.
#
# ⚠ ОЛОН ХАНДАЛТ: pool дүүрмэгц шинэ хүсэлт холболт хүлээж эхэлдэг ба 10
#   секундын дараа "холболт авч чадсангүй" гэж унана. Хэрэглэгч олноор
#   орох үед хамгийн түрүүнд ЭНЭ тоо хананд мөргөдөг. Өөрийн сервертэй
#   (VPS) бол Postgres-ийн `max_connections`-ыг харгалзан 10-20 өгнө:
#       НИЙТ = DATABASE_POOL_MAX × PM2 instance-ийн тоо ≤ max_connections − 10
DATABASE_POOL_MAX=10

# Нэг асуулга хэдэн мс-ээс удвал албадан таслах вэ.
#
# ЯАГААД ХЭРЭГТЭЙ: индексгүй нэг хүнд асуулга эсвэл түгжээ хүлээлт нь
# pool-ийн холболтыг мөнхөд барьж, ҮЛДСЭН БҮХ хүсэлтийг цуг унагаадаг —
# гаднаас нь "сайт унасан" мэт харагдана. Таслалттай бол гэмтэл тухайн
# нэг route-д хязгаарлагдана.
#
# 0 = хязгааргүй. Урт ажил (нөөцлөлт, миграц) ажиллуулахдаа л 0 болгоно.
DATABASE_STATEMENT_TIMEOUT_MS=10000

# ⚠ PM2 CLUSTER MODE-той бол ЭНД: instance бүр өөрийн pool-той тул НИЙТ
# холболт = DATABASE_POOL_MAX × instance-ийн тоо. Жишээ нь 2 instance × 10 =
# 20 холболт — Postgres-ийн `max_connections`-аас (анхдагч ~100)
# хэтрэхгүйг шалгаарай. `deploy/ecosystem.config.js` харна уу.


# -----------------------------------------------------------------------------
# Redis (заавал биш нэг instance-д; PM2 cluster mode-д ЗААВАЛ)
# -----------------------------------------------------------------------------
# Хоосон бол Redis ашиглахгүй — хурдны хязгаарлагч (rateLimit.ts) ба курсын
# каталогийн кэш (cache.ts) процессын дотоод санах ойд ажиллана. Энэ нь НЭГ
# PM2 instance (жишээ нь локал хөгжүүлэлт) дээр бүрэн зөв ажиллана.
#
# ⚠ Хэрэв PM2 cluster mode-оор (instances > 1) ажиллуулж байгаа бол ЗААВАЛ
#   тохируулна. Тохируулаагүй бол instance тус бүр өөрийн санах ойд тусад нь
#   тоолж, хурдны хязгаар instance-ийн тоогоор үржиж, кэш ч хуваалцагдахгүй.
REDIS_URL=redis://127.0.0.1:6379


# -----------------------------------------------------------------------------
# Firebase — клиент тал (нэвтрэлт)
# -----------------------------------------------------------------------------
# Эдгээр утга нь НУУЦ БИШ — хөтөч рүү ил очдог. Хамгаалалт нь Firebase-ийн
# Security Rules ба серверийн token шалгалт дээр тогтоно.
#
# Хаанаас авах вэ: Firebase Console → Project settings → General →
#                  Your apps → Web app → SDK setup and configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Заавал биш — Google Analytics хэрэглэхгүй бол хоосон үлдээнэ
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=


# -----------------------------------------------------------------------------
# Firebase — сервер тал (Admin SDK)
# -----------------------------------------------------------------------------
# API route бүр хэрэглэгчийн ID token-ыг ЭНЭ түлхүүрээр шалгана. Буруу бол
# нэвтрэлт бүхэлдээ унана.
#
# Хаанаас авах вэ: Firebase Console → Project settings → Service accounts →
#                  Generate new private key (JSON татагдана)
FIREBASE_PROJECT_ID=your-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# ⚠ PEM түлхүүрийг НЭГ МӨРӨНД, мөр таслалтыг `\n` болгож бичнэ. Бүхэлд нь
#   давхар хашилтад хийнэ. Hosting панелиуд хашилт, backslash-ийг өөр өөрөөр
#   боловсруулдаг тул зөв уншигдсан эсэхийг `/api/health` дээр шалгана уу.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"


# -----------------------------------------------------------------------------
# Сайтын нийтийн хаяг
# -----------------------------------------------------------------------------
# Хуваалцах холбоос (og:image, canonical, sitemap.xml, robots.txt) БҮГД
# эндээс бүтэн хаягаа авна. Хоосон бол production домэйн — https://daamal.org
# (src/lib/brand.ts → BRAND_URL).
#
# ⚠ NEXT_PUBLIC_ угтвартай тул BUILD ҮЕД шигтгэгдэнэ — солисны дараа зөвхөн
#   restart ХАНГАЛТГҮЙ, ЗААВАЛ дахин build хийнэ.
#
# ⚠ Төгсгөлд нь ташуу зураас (/) ТАВИХГҮЙ — давхар зураастай холбоос үүснэ.
#
# Жишээ (туршилтын орчин): https://staging.daamal.org
NEXT_PUBLIC_SITE_URL=


# -----------------------------------------------------------------------------
# Session cookie (заавал биш — олон дэд домэйн хуваалцах SSO)
# -----------------------------------------------------------------------------
# Нэвтэрсний дараа сервер нь ID token-ыг HttpOnly cookie болгож солино
# (`/api/auth/session`). Энэ нь ХОЁР зүйлийг нээнэ:
#   • дэд домэйнууд (learn.daamal.org, admin.daamal.org) НЭГ л удаа нэвтрэхэд
#     бүгд нээгдэнэ
#   • server component / proxy нь хүсэлтийн эхэнд хэрэглэгчийг таьина
#
# ⚠ Энэ нь Firebase Admin SDK (FIREBASE_PRIVATE_KEY гэх мэт) ЗААВАЛ
#   тохируулагдсан байхыг шаардана — cookie-г тэр түлхүүрээр гарын үсэг
#   зурдаг. Тохируулаагүй бол `/api/auth/session` нь 501 буцаах ба апп
#   өмнөх шигээ `Authorization: Bearer` токеноор БҮРЭН ажиллана.

# Cookie-г аль домэйнд тавих вэ.
#   хоосон       → зөвхөн одоогийн хост (localhost, нэг домэйнт байршуулалт)
#   .daamal.org  → бүх дэд домэйн хуваалцана
# ⚠ Заавал цэгээр эхлүүлнэ. Цэггүй бол зарим хөтөч дэд домэйн руу дамжуулахгүй.
SESSION_COOKIE_DOMAIN=

# Cookie хэдэн хоног хүчинтэй байх вэ. Firebase-ийн дээд хязгаар нь 14 —
# түүнээс их утга бичвэл 14 болж хумигдана.
SESSION_COOKIE_DAYS=14


# -----------------------------------------------------------------------------
# QPay (заавал биш — Premium төлбөр)
# -----------------------------------------------------------------------------
# Хоосон бол "sandbox горим": `/premium` бүрэн ажиллана, гэхдээ жинхэнэ QPay
# рүү ОГТ хандахгүй — QR нь хуурамч, төлбөрийг зөвхөн локал/сорилтын
# "Тест: төлбөр төлөгдсөн" товчоор (`/api/billing/subscriptions/[id]/dev-complete`,
# ЗӨВХӨН энэ горимд ажилладаг) баталгаажуулж болно. Гурвыг ХАМТ бөглөмөгц
# кодыг ЗАСАХГҮЙГЭЭР бодит горимд шилжинэ.
#
# Хаанаас авах вэ: https://merchant.qpay.mn мерчадын мэдээлэл
QPAY_CLIENT_ID=
QPAY_CLIENT_SECRET=
QPAY_INVOICE_CODE=

# Заавал биш — QPay-ийн бизнесийн орчин өөр бол (sandbox/production API)
QPAY_BASE_URL=https://merchant.qpay.mn/v2


# -----------------------------------------------------------------------------
# Апп
# -----------------------------------------------------------------------------
# Имэйлийн холбоос, QPay-ийн буцах дуудлага (callback), эргэн шилжих хаяг.
#
# ⚠ ПРОД ДЭЭР ЗААВАЛ https://daamal.org гэж тавина. Локал утга (localhost)
#   үлдвэл QPay төлбөрийн баталгаажуулалт таны сервер рүү ХЭЗЭЭ Ч ирэхгүй —
#   банк localhost руу залгаж чадахгүй (`src/lib/api/qpay.ts`).
#
# ⚠ Энэ нь дээрх NEXT_PUBLIC_SITE_URL-аас ӨӨР зорилготой ч прод дээр ижил
#   утгатай байх ёстой: SITE_URL нь SEO/хуваалцах холбоост, APP_URL нь
#   гуравдагч талын буцах дуудлагад.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Дараалал (streak), өдрийн зорилтыг тооцох цагийн бүс. Өгөгдлийн сан бүх
# мөчийг UTC-гээр хадгалдаг тул "өнөөдөр" гэдгийг ЭНЭ бүсээр шийднэ —
# эс бөгөөс оройдоо хичээллэдэг сурагчийн дараалал буруу тасарна.
APP_TIMEZONE=Asia/Ulaanbaatar


# -----------------------------------------------------------------------------
# Google AdSense (заавал биш — реклам)
# -----------------------------------------------------------------------------
# Хоосон бол реклам ЗӨВХӨН зайны placeholder-ээр харагдана (dashed хүрээтэй
# "Рекламын байршил" гэсэн бичээстэй хайрцаг) — сайт бүрэн ажиллана, зөвхөн
# бодит зар зурагдахгүй. `lib/tactiq/ads.ts` болон `components/tactiq/
# AdSlot.tsx` үзнэ үү.
#
# Хаанаас авах вэ: https://www.google.com/adsense дээр акаунт үүсгээд
#                  сайтаа баталгаажуулна → CLIENT_ID (жишээ нь
#                  "ca-pub-1234567890123456"). Дараа нь байршил (сурах
#                  хуудасны жагсаалт/хажуугийн багана/банер) тус бүрд зар
#                  нэгж ("ad unit") үүсгээд SLOT_ID-г нь авна.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
# `AppShell`-ийн өргөн дэлгэц (xl+, "вэбсайт") дээрх хажуугийн баганын зар
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
# `AppShell`-ийн нарийн дэлгэц (<xl, гар утасны "апп") дээрх хөндлөн банер
NEXT_PUBLIC_ADSENSE_SLOT_BANNER=

# ⚠ Тоглоом дууссаны дараах видео реклам (`GameOverAd`,
#   `components/tactiq/GameOverAd.tsx`) дээрх хувьсагч ЭНД БАЙХГҮЙ — энгийн
#   AdSense зар нэгжээр видео/interstitial зар гаргах боломжгүй тул тэр нь
#   одоохондоо placeholder хэвээр байгаа бөгөөд бодит холболт хийхэд Google
#   Ad Manager (GPT) эсвэл AdMob-ийн rewarded/interstitial ad шаардлагатай.


# -----------------------------------------------------------------------------
# Аюулгүй байдал (заавал биш)
# -----------------------------------------------------------------------------
# Content-Security-Policy горим: enforce | report-only | off
# Шинэ гуравдагч талын скрипт нэмэхэд эхлээд `report-only`-оор туршина.
CSP_MODE=enforce

# `/api/health` нь тохиргооны байдлыг задалж харуулдаг тул нээлттэй сервер
# дээр токеноор хамгаална: /api/health?token=...
HEALTH_TOKEN=


# -----------------------------------------------------------------------------
# Тэмцээний систем (заавал биш — chess.daamal.org)
# -----------------------------------------------------------------------------
# Тэмцээн нь ачаалал өндөртэй (олон зуун хүн НЭГ агшинд хос сугалж, цаг
# тоолж, үр дүн илгээнэ) тул үндсэн сургалтын аппаас ТУСДАА серверт
# ажиллана. Тэмцээн унасан ч хичээл үргэлжилнэ.
#
# БҮРТГЭЛ НЬ НЭГ: тэмцээний сайт өөрийн нууц үг эрхлэхгүй. Хэрэглэгч энд
# нэвтэрсэн бол `/tournament` дээр богино хугацааны тасалбар авч тэр сайт
# руу шилжинэ; тэмцээний СЕРВЕР түүнийг `/api/tournament/exchange` дээр
# Firebase custom token болгон солино (ижил uid).
#
# Хоосон бол цэсэнд «Тэмцээн» ОГТ гарахгүй — апп бүрэн ажиллана.
#
# ⚠ NEXT_PUBLIC_ угтвартай тул BUILD ҮЕД шигтгэгдэнэ — солисны дараа зөвхөн
#   restart ХАНГАЛТГҮЙ, ЗААВАЛ дахин build хийнэ.
# ⚠ Төгсгөлд нь ташуу зураас (/) ТАВИХГҮЙ.
NEXT_PUBLIC_TOURNAMENT_URL=

# Хоёр серверийн ХУВААЛЦАХ нууц түлхүүр. Тэмцээний сервер үүнийг
# `x-tournament-secret` толгойд хийж `/api/tournament/exchange` рүү залгана.
#
# ⚠ ХАМГИЙН БАГА 32 тэмдэгт — богино бол тасалбар олгох боломж унтарна.
# ⚠ Хөтөч рүү ХЭЗЭЭ Ч очихгүй (NEXT_PUBLIC_ угтваргүй). Тэмцээний сервер
#   дээр ЯГ ижил утгыг тавина.
#
# Үүсгэх: openssl rand -base64 48
TOURNAMENT_SHARED_SECRET=
